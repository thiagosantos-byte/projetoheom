{
  "name": "heom-plataforma",
  "version": "0.5.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "tsx watch apps/api/src/demo-server.ts",
    "build": "npm run build -w @heom/api && npm run build -w @heom/web",
    "typecheck": "npm run typecheck -w @heom/api && npm run typecheck -w @heom/web",
    "test": "npm run test -w @heom/api",
    "start": "node scripts/start-production.mjs",
    "start:demo": "node scripts/start-production.mjs",
    "db:migrate": "npm run db:migrate -w @heom/api",
    "db:seed": "npm run db:seed -w @heom/api"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": "22.x",
    "npm": ">=10.0.0"
  },
  "type": "module"
}
