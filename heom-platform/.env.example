# Copie este arquivo para .env antes de iniciar.
NODE_ENV=development
APP_NAME=HEOM — Gestão de Ativos Hospitalares
APP_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Modo completo (opcional): conexão com PostgreSQL local.
# O modo padrão de teste sem Docker usa arquivo JSON e ignora DATABASE_URL.
DATABASE_URL=postgresql://heom:heom_local_dev@localhost:5432/heom

# Autenticação local. Gere um segredo exclusivo antes de qualquer implantação.
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_LONGO_E_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
JWT_EXPIRES_IN=8h

# Conta inicial criada pelo seed. Altere a senha antes de qualquer uso institucional.
INITIAL_ADMIN_NAME=Administrador HEOM
INITIAL_ADMIN_EMAIL=admin@heom.local
INITIAL_ADMIN_PASSWORD=TroqueEstaSenha!2026

# Demonstração: os registros criados pelo seed são fictícios e ficam identificados como SIMULADO.
DEMO_MODE=true
# Exibe perfis de avaliação no modo demonstrativo local. O servidor institucional não oferece esse recurso.
ENABLE_DEMO_PROFILES=true
# O servidor demonstrativo fica somente na máquina local por padrão.
DEMO_BIND_HOST=127.0.0.1

# MQTT local (somente para modo completo com PostgreSQL/Mosquitto).
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=heom/tracking/observations

# Armazenamento local de fotografias e anexos (caminho relativo à raiz do projeto ou absoluto).
HEOM_STORAGE_DIR=storage
MAX_ASSET_PHOTO_MB=12

# OCR local opcional. Instale Tesseract no Windows e os pacotes de idioma por+eng.
TESSERACT_CMD=tesseract
TESSERACT_LANG=por+eng
